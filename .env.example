# ==============================================================================
# LexHubPro 配置示例
# ------------------------------------------------------------------------------
# 用法：cp .env.example .env 后按注释填写。.env 禁止提交仓库。
# 规则详见 docs/rules/03-configuration.md
#
# 【重要】Atoms 平台 Publish 场景下，下方标注「平台注入」的变量由平台自动提供，
#        不要在 .env 中填写或覆盖；本文件主要服务于本地开发与 Docker Compose 自托管。
# 【重要】所有 VITE_ 前缀变量会被打进前端构建产物，属公开信息，禁止放任何密钥。
# ==============================================================================


# ------------------------------------------------------------------------------
# 一、平台注入变量（只读消费，平台环境禁止覆盖）
# ------------------------------------------------------------------------------

# PostgreSQL 连接串。平台注入；仅自托管时需自填。
# 必填：是（自托管）  默认值：无
# 容器网络内必须使用服务名而非 localhost。
DATABASE_URL=postgresql+asyncpg://lexhubpro:lexhubpro@db:5432/lexhubpro

# 前端站点地址，用于 OIDC 登出回跳。平台注入。
# 必填：否  默认值：无（缺失或仍为 $$FRONTEND_DOMAIN$$ 占位符时，后端回退到当前请求 host 并记 WARNING）
FRONTEND_URL=http://localhost:5173

# 后端对外地址。平台注入。
# 必填：否  默认值：由 host/port 推导（http://127.0.0.1:8000）
PYTHON_BACKEND_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# 二、后端应用配置
# ------------------------------------------------------------------------------

# 调试模式。开启后 SQLAlchemy 会输出 SQL 回显，生产环境必须为 false。
# 必填：否  默认值：false
DEBUG=false

# 后端监听地址与端口。
# 必填：否  默认值：0.0.0.0 / 8000
HOST=0.0.0.0
PORT=8000


# ------------------------------------------------------------------------------
# 三、合同审查业务配置
# ------------------------------------------------------------------------------

# 合同审查使用的文本模型（结构化风险审查）。
# 必填：否  默认值：claude-opus-5
REVIEW_MODEL=claude-opus-5

# 审查生成的采样温度，越低越稳定（结构化输出建议 0.0-0.3）。
# 必填：否  默认值：0.2
REVIEW_TEMPERATURE=0.2

# 审查生成的最大输出 token 数。
# 必填：否  默认值：8192
REVIEW_MAX_TOKENS=8192

# 送入模型的合同文本最大字符数，超出部分截断。
# 必填：否  默认值：60000
REVIEW_MAX_CONTRACT_CHARS=60000

# 允许上传的合同 PDF 最大体积（MB，原始文件）。
# 必填：否  默认值：15
MAX_CONTRACT_FILE_MB=15

# 允许上传的合同 PDF 最大页数。
# 必填：否  默认值：80
MAX_CONTRACT_PAGE_COUNT=80

# 合同文件所在的私有对象存储桶名。
# 必填：否  默认值：contracts
CONTRACT_BUCKET=contracts

# AI 返回 JSON 解析失败时的修复重试次数（0 表示不重试）。
# 必填：否  默认值：1
REVIEW_JSON_REPAIR_RETRIES=1


# ------------------------------------------------------------------------------
# 四、数据库连接池与运行环境（运维层配置）
# ------------------------------------------------------------------------------

# 是否运行于 AWS Lambda 环境。平台注入，自托管保持 false。
# 必填：否  默认值：false
IS_LAMBDA=false

# 连接池参数（仅 Lambda 环境生效，非 Lambda 使用内置 QueuePool 默认值）。
# 必填：否  默认值：1 / 2 / 280
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=280

# 应急开关：设为 true 时改用 NullPool（每请求新建连接）。
# 必填：否  默认值：false
DB_DISABLE_POOL=false

# 设置该变量（任意值）将跳过启动时的建表流程。
# 必填：否  默认值：不设置
# MGX_IGNORE_INIT_TABLES=1


# ------------------------------------------------------------------------------
# 五、日志配置（由 app/backend/utils/logging_utils.py 消费）
# ------------------------------------------------------------------------------

# 是否启用旧日志文件自动清理。设为 0/false/no/off 可关闭。
# 必填：否  默认值：true
FUNCSEA_BACKEND_LOG_CLEANUP_ENABLED=true

# 保留的历史日志文件数量上限。
# 必填：否  默认值：10
FUNCSEA_BACKEND_LOG_BACKUP_COUNT=10

# 历史日志文件总体积上限（MB）。
# 必填：否  默认值：10
FUNCSEA_BACKEND_LOG_MAX_TOTAL_MB=10

# 日志级别：DEBUG / INFO / WARNING / ERROR。
# 必填：否  默认值：INFO
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 六、前端构建期配置（VITE_ 前缀，公开信息，禁止放密钥）
# ------------------------------------------------------------------------------

# 站点展示名称。
# 必填：否  默认值：LexHubPro
VITE_APP_NAME=LexHubPro

# 审查接口前端超时时间（毫秒）。该接口内部串联两次 AI 调用，不得低于 600000。
# 必填：否  默认值：600000
VITE_REVIEW_API_TIMEOUT_MS=600000

# 前端允许选择的合同文件体积上限（MB），应与 MAX_CONTRACT_FILE_MB 保持一致。
# 必填：否  默认值：15
VITE_MAX_CONTRACT_FILE_MB=15

# 历史记录列表每页条数。
# 必填：否  默认值：20
VITE_HISTORY_PAGE_SIZE=20



# ------------------------------------------------------------------------------
# 七、认证与 MinIO
# ------------------------------------------------------------------------------

# JWT 签名密钥。至少 32 字符。
# 必填：是  默认值：无
# 生成方式示例：openssl rand -hex 32
JWT_SECRET_KEY=

# JWT 签名算法。core.auth 裸读该配置，缺失会导致登录 500。
# 必填：是  默认值：HS256
JWT_ALGORITHM=HS256

# 是否强制验证邮箱后才能登录。配置了可用 SMTP 时始终强制。
# 必填：否  默认值：compose 为 true
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# 发信提供方：mailpit | 163 | gmail。注册收件箱仅允许 163 / Gmail。
# mailpit：本地收件箱 http://localhost:8025，无需账号。
# 163：SMTP_USER 必须是 163 邮箱，SMTP_PASSWORD 为授权码（不是登录密码），默认 smtp.163.com:465 SSL。
# gmail：SMTP_USER 为 Gmail，SMTP_PASSWORD 为应用专用密码，默认 smtp.gmail.com:587 STARTTLS。
# 必填：是（要真实发信时 163/gmail 必须填 USER 与 PASSWORD）
SMTP_PROVIDER=mailpit
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=
SMTP_STARTTLS=
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# 自建认证邮件中链接使用的站点地址（邮箱验证、密码重置）。
# 必填：否（缺失只影响邮件链接，登录不受影响）  默认值：无
AUTH_PUBLIC_BASE_URL=http://localhost:5173

# 首次启动时将该邮箱置为已验证管理员，避免 console 邮件导致无法登录。
# 必填：否  默认值：空（不引导）
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# S3 兼容存储服务地址。容器网络内必须用服务名而非 localhost。
# 必填：是（）  默认值：无
MINIO_ENDPOINT=http://minio:9000

# 预签名下载 URL 对外地址。签名与 host 绑定，浏览器必须能访问该 host。
# 内外网分离时必填；未填则回退 MINIO_ENDPOINT。
# 必填：否  默认值：同 MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# S3 兼容存储访问凭据。自托管下与 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 一致。
# 必填：是（）  默认值：无
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 存储区域标识。MinIO 不校验该值，但 S3 签名算法要求必须存在。
# 必填：否  默认值：us-east-1
MINIO_REGION=us-east-1

# 寻址风格：path | virtual。MinIO 默认不支持虚拟主机风格，须保持 path。
# 必填：否  默认值：path
MINIO_ADDRESSING_STYLE=path

# 是否校验存储服务的 TLS 证书。仅在自签证书的内网环境才可关闭。
# 必填：否  默认值：true
MINIO_VERIFY_TLS=true

# 预签名下载链接有效期（秒）。过长的链接一旦泄露等同长期公开访问。
# 必填：否  默认值：900
MINIO_PRESIGN_EXPIRES_SECONDS=900


# ------------------------------------------------------------------------------
# 八、Docker Compose 自托管专用（详见 docs/rules/08-deployment.md）
# ------------------------------------------------------------------------------

# PostgreSQL 容器初始化参数。
# 必填：是（自托管）  默认值：如下
POSTGRES_USER=lexhubpro
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=lexhubpro

# MinIO 容器初始化凭据。backend 的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY 复用这两个值。
# 必填：是（自托管）  默认值：如下
MINIO_ROOT_USER=lexhubpro
MINIO_ROOT_PASSWORD=change_me_in_production

# 宿主机端口映射。
# 必填：否  默认值：5432 / 8000 / 5173 / 9000 / 9001
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001