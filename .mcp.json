{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "app/frontend/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--isolated",
        "--ignore-https-errors",
        "--caps",
        "vision"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "${HOME}/Library/Caches/ms-playwright"
      }
    }
  }
}
